@model List<Blog>
@{ ViewData["Title"] = $"Etiket: {ViewBag.Tag}"; Layout = "~/Views/Shared/_PublicLayout.cshtml"; }
<header class="lp-page-heading"><div class="lp-container"><nav class="lp-breadcrumb" aria-label="İçerik yolu"><a asp-controller="Home" asp-action="Deneme">Ana Sayfa</a><span aria-hidden="true">/</span><a asp-controller="Home" asp-action="Deneme" asp-route-bolum="blog">Blog</a></nav><h1>Etiket: @ViewBag.Tag</h1></div></header>
<section class="lp-section"><div class="lp-container"><div class="lp-grid">
@foreach (var item in Model ?? new List<Blog>()) { <partial name="~/Views/Shared/Public/_BlogCard.cshtml" model="item" /> }
</div>@if (Model == null || !Model.Any()) { <p class="lp-empty">Bu etikete ait blog bulunamadı.</p> }</div></section>
