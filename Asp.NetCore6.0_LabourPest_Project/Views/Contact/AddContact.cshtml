@model Contact
@{ ViewData["Title"] = "İletişim ve teklif talebi"; Layout = "~/Views/Shared/_PublicLayout.cshtml"; }
<header class="lp-page-heading"><div class="lp-container"><nav class="lp-breadcrumb" aria-label="İçerik yolu"><a asp-controller="Home" asp-action="Deneme">Ana Sayfa</a><span aria-hidden="true">/</span><span>İletişim</span></nav><h1>Birlikte çözüm bulalım.</h1><p>İhtiyacınızı paylaşın, hizmetlerimiz hakkında bilgi alın.</p></div></header>
<section class="lp-section"><div class="lp-container lp-detail-grid">
    <div class="lp-panel"><h2>Bize yazın</h2><p class="lp-help">Yıldız (*) ile işaretlenmiş alanlar zorunludur.</p>
        <form class="lp-form" method="post" action="/Contact/AddContact">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" role="alert"></div>
            <div class="lp-form-grid">
                <div><label for="ContactUserName">Adınız soyadınız *</label><input asp-for="ContactUserName" autocomplete="name" required /><span asp-validation-for="ContactUserName"></span></div>
                <div><label for="ContactMail">E-posta adresiniz *</label><input asp-for="ContactMail" type="email" autocomplete="email" required /><span asp-validation-for="ContactMail"></span></div>
            </div>
            <div><label for="ContactSubject">Konu *</label><input asp-for="ContactSubject" required /><span asp-validation-for="ContactSubject"></span></div>
            <div><label for="ContactMessage">Mesajınız</label><textarea asp-for="ContactMessage" rows="6"></textarea><span asp-validation-for="ContactMessage"></span></div>
            <div><button class="lp-button" type="submit">Mesajı gönder <span aria-hidden="true">↗</span></button></div>
        </form>
    </div>
    <partial name="~/Views/Shared/Public/_ContactInfo.cshtml" />
</div></section>
