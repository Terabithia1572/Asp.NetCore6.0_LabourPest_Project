@using Asp.NetCore6._0_LabourPest_Project.Presentation
@model Blog
@{ ViewData["Title"] = Model?.BlogTitle ?? "Blog"; Layout = "~/Views/Shared/_PublicLayout.cshtml"; }
<header class="lp-page-heading"><div class="lp-container lp-reading"><nav class="lp-breadcrumb" aria-label="İçerik yolu"><a asp-controller="Home" asp-action="Deneme">Ana Sayfa</a><span aria-hidden="true">/</span><a asp-controller="Home" asp-action="Deneme" asp-route-bolum="blog">Blog</a></nav><h1>@ViewData["Title"]</h1></div></header>
<section class="lp-section"><div class="lp-container lp-reading">
@if (Model != null)
{
    <article>
        <div class="lp-meta">@if (Model.BlogDate != default) { <time datetime="@Model.BlogDate.ToString("yyyy-MM-dd")">@Model.BlogDate.ToString("dd.MM.yyyy")</time> } @if (Model.Writer != null) { <span aria-hidden="true">·</span><span>@Model.Writer.WriterName @Model.Writer.WriterSurname</span> }</div>
        <img class="lp-detail-image" src="@Url.Content(PublicContent.Image(Model.BlogImage))" alt="@Model.BlogTitle" width="800" height="500" data-fallback />
        <div class="lp-prose">@Html.Raw(Model.BlogContent)</div>
        @if (Model.BlogTags != null && Model.BlogTags.Any())
        {
            <nav class="lp-tags" aria-label="Yazı etiketleri">@foreach (var tag in Model.BlogTags.Where(x => x.Tags != null)) { <a asp-controller="Tag" asp-action="Blogs" asp-route-id="@tag.Tags.TagName">@tag.Tags.TagName</a> }</nav>
        }
    </article>
    <section id="comments" class="lp-comments"><h2>Yorumlar</h2>
        @await Component.InvokeAsync("BlogCommentList", new { id = Model.BlogID })
        <div id="respond">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Blog" asp-action="AddComment" method="post" id="commentform" class="lp-form">
                    <input type="hidden" name="BlogID" value="@Model.BlogID" />
                    <input type="hidden" name="ParentCommentID" id="ParentCommentID" value="" />
                    <div><label for="title">Konu *</label><input id="title" name="title" type="text" required /></div>
                    <div><label for="comment234">Yorum *</label><textarea id="comment234" name="comment" rows="4" required></textarea></div>
                    <div><input name="submit" type="submit" class="lp-button" value="Gönder" /></div>
                </form>
            }
            else { <p>Yorum yapmak için lütfen <a asp-controller="Login" asp-action="SignIN">giriş yapın</a>.</p> }
        </div>
    </section>
}
else { <p>Yazı bulunamadı.</p> }
</div></section>
@section Scripts { <script src="~/js/comment-edit.js" defer></script> }
