@model JobApplication
@{ ViewData["Title"] = "İş başvurusu"; Layout = "~/Views/Shared/_PublicLayout.cshtml"; }
<header class="lp-page-heading"><div class="lp-container"><nav class="lp-breadcrumb" aria-label="İçerik yolu"><a asp-controller="Home" asp-action="Deneme">Ana Sayfa</a><span aria-hidden="true">/</span><span>İş başvurusu</span></nav><h1>LabourPest'te çalışmak ister misiniz?</h1><p>Kendinizi tanıtın ve özgeçmişinizi bizimle paylaşın.</p></div></header>
<section class="lp-section"><div class="lp-container lp-detail-grid"><div class="lp-panel"><h2>Başvuru formu</h2><p class="lp-help">Yıldız (*) ile işaretlenmiş alanlar zorunludur.</p>
<form class="lp-form" method="post" asp-action="AddJobApplication" asp-controller="JobApplication" enctype="multipart/form-data">
    <div asp-validation-summary="All" role="alert"></div>
    <div class="lp-form-grid"><div><label for="JobApplicationName">Adınız *</label><input asp-for="JobApplicationName" autocomplete="given-name" required /></div><div><label for="JobApplicationSurName">Soyadınız *</label><input asp-for="JobApplicationSurName" autocomplete="family-name" required /></div></div>
    <div class="lp-form-grid"><div><label for="JobApplicationNumber">Telefon numaranız *</label><input asp-for="JobApplicationNumber" type="tel" autocomplete="tel" required /></div><div><label for="JobApplicationMail">E-posta adresiniz *</label><input asp-for="JobApplicationMail" type="email" autocomplete="email" required /></div></div>
    <div><label for="JobApplicationAboutYou">Kendinizden bahsedin</label><textarea asp-for="JobApplicationAboutYou" rows="5"></textarea></div>
    <div><label for="JobApplicationCV">Özgeçmişiniz *</label><p class="lp-help" id="cv-help">PDF, DOC veya DOCX dosyası seçin.</p><input type="file" name="JobApplicationCV" id="JobApplicationCV" accept=".pdf,.doc,.docx" aria-describedby="cv-help" required /></div>
    <div><button class="lp-button" type="submit">Başvuruyu gönder <span aria-hidden="true">↗</span></button></div>
</form></div><partial name="~/Views/Shared/Public/_ContactInfo.cshtml" /></div></section>
