@using Asp.NetCore6._0_LabourPest_Project.Presentation
@model Services
@{ ViewData["Title"] = Model?.ServicesTitle ?? "Hizmet bilgisi"; Layout = "~/Views/Shared/_PublicLayout.cshtml"; }
<header class="lp-page-heading"><div class="lp-container"><nav class="lp-breadcrumb" aria-label="İçerik yolu"><a asp-controller="Home" asp-action="Deneme">Ana Sayfa</a><span aria-hidden="true">/</span><a asp-controller="Home" asp-action="Deneme" asp-route-bolum="hizmetler">Hizmetlerimiz</a></nav><h1>@ViewData["Title"]</h1></div></header>
<section class="lp-section"><div class="lp-container lp-detail-grid">
@if (Model != null)
{
    <article class="lp-prose"><img class="lp-detail-image" src="@Url.Content(PublicContent.Image(Model.ServicesImageURL))" alt="@Model.ServicesTitle" width="800" height="500" data-fallback /><p class="lp-lead">@Model.ServicesDescription</p><p>@Model.ServicesLongDescription</p><a class="lp-text-link" asp-controller="Home" asp-action="Deneme" asp-route-bolum="hizmetler">← Tüm hizmetlere dön</a></article>
}
else { <p>Hizmet bilgisi bulunamadı.</p> }
<aside class="lp-panel lp-contact-info"><p class="lp-eyebrow">Bilgi ve teklif</p><h2>Bu hizmet hakkında konuşalım.</h2><p>İhtiyacınıza uygun uygulama için bizimle iletişime geçin.</p><div class="lp-actions"><a class="lp-button" asp-controller="Contact" asp-action="AddContact">Teklif isteyin ↗</a><a class="lp-text-link" href="tel:+905336992275">0533 699 22 75</a></div></aside>
</div></section>
