@using Asp.NetCore6._0_LabourPest_Project.Presentation
@model List<WhoWeUs>
@{ var items = Model ?? new List<WhoWeUs>(); }
<section id="corporate" class="lp-section lp-tinted"><div class="lp-container">
    <div class="lp-section-heading"><div><p class="lp-eyebrow">Kurumsal yaklaşımımız</p><h2>Vizyon, misyon ve kalite politikamız</h2></div></div>
    <div class="lp-policy-grid">
    @foreach (var item in items)
    {
        var title = string.IsNullOrWhiteSpace(item.WhoWeUsTitle2) ? item.WhoWeUsTitle1 : item.WhoWeUsTitle2;
        <article class="lp-policy">
            <h3>@title</h3>
            <p class="lp-policy-preview">@PublicContent.Excerpt(string.Join(" ", item.WhoWeUsDescription1, item.WhoWeUsDescription2), 190)</p>
            <details class="lp-disclosure lp-policy-details" id="policy-@item.WhoWeUsID">
                <summary aria-controls="policy-content-@item.WhoWeUsID"><span class="lp-policy-read">Devamını oku</span><span class="lp-policy-close">Metni kapat</span><span class="lp-sr-only">: @title</span></summary>
                <div id="policy-content-@item.WhoWeUsID" class="lp-prose"><p>@item.WhoWeUsDescription1</p><p>@item.WhoWeUsDescription2</p></div>
            </details>
        </article>
    }
    </div>
    @if (items.Count == 0) { <p class="lp-empty">Kurumsal bilgilerimiz için bizimle iletişime geçebilirsiniz.</p> }
</div></section>
