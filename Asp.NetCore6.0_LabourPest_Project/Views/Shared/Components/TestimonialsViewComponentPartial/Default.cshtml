@using Asp.NetCore6._0_LabourPest_Project.Presentation
@model List<Comment>
@{ var reviews = (Model ?? new List<Comment>()).Take(PublicReviews.MaximumCount).ToList(); }
<section id="reviews" class="lp-section lp-tinted" data-carousel="reviews" role="region" aria-roledescription="slayt gösterisi" aria-labelledby="reviews-heading">
    <div class="lp-container">
        <div class="lp-section-heading"><div><p class="lp-eyebrow">Sizden gelenler</p><h2 id="reviews-heading">Müşteri yorumları</h2></div>
        @if (reviews.Count > 1)
        {
            <div class="lp-review-controls" data-carousel-controls hidden><span class="lp-carousel-counter" data-carousel-counter aria-live="polite" aria-atomic="true"></span><div class="lp-carousel-arrows"><button type="button" data-carousel-prev aria-controls="review-slides" aria-label="Önceki yorumlar">←</button><button type="button" data-carousel-next aria-controls="review-slides" aria-label="Sonraki yorumlar">→</button></div></div>
        }
        </div>
        @if (reviews.Count == 0)
        {
            <p class="lp-review-empty">Şu anda gösterilecek bir müşteri yorumu bulunmuyor. Deneyiminizi yukarıdaki formdan paylaşabilirsiniz.</p>
        }
        else
        {
            <div class="lp-review-grid" id="review-slides" data-carousel-track>
            @for (var i = 0; i < reviews.Count; i++)
            {
                var review = reviews[i];
                var author = string.IsNullOrWhiteSpace(review.CommentUserName) ? "Müşteri" : review.CommentUserName.Trim();
                var initial = System.Globalization.StringInfo.GetNextTextElement(author);
                <article class="lp-review-card" data-carousel-item role="group" aria-roledescription="yorum" aria-label="@($"{i + 1} / {reviews.Count}")">
                    <div class="lp-review-author"><span class="lp-avatar" aria-hidden="true">@initial</span><span>@author</span></div>
                    @if (!string.IsNullOrWhiteSpace(review.CommentTitle)) { <h3>@review.CommentTitle</h3> }
                    <blockquote>@review.CommentContent</blockquote>
                </article>
            }
            </div>
        }
    </div>
</section>
