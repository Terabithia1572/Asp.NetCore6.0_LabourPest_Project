@using Asp.NetCore6._0_LabourPest_Project.Presentation
@model List<HomePage>
@inject Asp.NetCore6._0_LabourPest_Project.Presentation.PublicImageVariants Images
@{ var slides = Model ?? new List<HomePage>(); }
<section id="home" class="lp-banner" data-carousel="hero" role="region" aria-roledescription="slayt gösterisi" aria-label="LabourPest tanıtımı">
    <h1 class="lp-sr-only">LabourPest · Profesyonel haşere kontrolü ve ilaçlama hizmetleri</h1>
    <div class="lp-banner-slides" id="home-slides" data-carousel-track>
    @for (var i = 0; i < slides.Count; i++)
    {
        var slide = slides[i];
        var heading = string.Join(" ", new[] { slide.HomePageDescription1, slide.HomePageDescription2 }.Where(x => !string.IsNullOrWhiteSpace(x)));
        var image = Url.Content(PublicContent.Image(slide.HomePageImage));
        var variants = Images.SrcSet(PublicContent.Image(slide.HomePageImage));
        <div class="lp-banner-slide" data-carousel-item role="group" aria-roledescription="slayt" aria-label="@($"{i + 1} / {slides.Count}")" hidden="@(i > 0)" inert="@(i > 0 ? "inert" : null)" aria-hidden="@(i > 0 ? "true" : null)">
            <img class="lp-banner-image" src="@(i == 0 ? image : null)" srcset="@(i == 0 ? variants : null)" data-slide-src="@(i > 0 ? image : null)" data-slide-srcset="@(i > 0 ? variants : null)" sizes="100vw" alt="" width="1600" height="650" loading="@(i == 0 ? "eager" : "lazy")" fetchpriority="@(i == 0 ? "high" : "low")" data-fallback />
            <div class="lp-container lp-banner-copy">
                <p class="lp-eyebrow">LabourPest · Haşere kontrol hizmetleri</p>
                <h2 class="lp-slide-title">@(string.IsNullOrWhiteSpace(heading) ? "Yaşam alanlarınız için haşere kontrolü." : heading)</h2>
                @if (!string.IsNullOrWhiteSpace(slide.HomePageSubDescription)) { <p class="lp-banner-description">@slide.HomePageSubDescription</p> }
                <div class="lp-actions"><a class="lp-button" asp-controller="Contact" asp-action="AddContact">Teklif isteyin <span aria-hidden="true">↗</span></a><a class="lp-button lp-banner-secondary" href="#services">Hizmetlerimizi keşfedin <span aria-hidden="true">↓</span></a></div>
            </div>
        </div>
    }
    @if (slides.Count == 0)
    {
        <div class="lp-container lp-banner-copy lp-banner-empty"><p class="lp-eyebrow">LabourPest</p><h2 class="lp-slide-title">Yaşam alanlarınız için haşere kontrolü.</h2><div class="lp-actions"><a class="lp-button" asp-controller="Contact" asp-action="AddContact">Bizimle iletişime geçin <span aria-hidden="true">↗</span></a></div></div>
    }
    </div>
    @if (slides.Count > 1)
    {
        <div class="lp-banner-controls lp-container" data-carousel-controls hidden>
            <div class="lp-carousel-arrows"><button type="button" data-carousel-prev aria-controls="home-slides" aria-label="Önceki slayt">←</button><button type="button" data-carousel-next aria-controls="home-slides" aria-label="Sonraki slayt">→</button></div>
            <div class="lp-carousel-dots" aria-label="Slayt seçimi">
            @for (var i = 0; i < slides.Count; i++)
            {
                <button type="button" data-carousel-dot="@i" aria-controls="home-slides" aria-label="@($"{i + 1}. slaytı göster")" aria-current="@(i == 0 ? "true" : null)"><span></span></button>
            }
            </div>
            <span class="lp-carousel-counter" data-carousel-counter aria-live="polite" aria-atomic="true">1 / @slides.Count</span>
        </div>
    }
</section>
