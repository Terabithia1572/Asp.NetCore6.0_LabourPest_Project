@using Asp.NetCore6._0_LabourPest_Project.Presentation
@model List<Category>
@{ var items = Model ?? new List<Category>(); }
<section id="category" class="lp-section"><div class="lp-container">
    <div class="lp-section-heading"><div><p class="lp-eyebrow">Hizmet ve uygulama bilgileri</p><h2>İlaç Kategorileri</h2></div></div>
    <div class="lp-category-grid">
    @foreach (var item in items)
    {
        <article class="lp-category">
            <a href="@Url.Content(PublicContent.Image(item.CategoryImages))" data-gallery aria-label="@($"{item.CategoryName} görselini büyüt")"><img src="@Url.Content(PublicContent.Image(item.CategoryImages))" alt="@item.CategoryName" width="240" height="240" loading="lazy" data-fallback /></a>
            <div><h3>@item.CategoryName</h3><p>@PublicContent.Excerpt(item.CategoryDescription, 180)</p>
            @if ((item.CategoryDescription?.Length ?? 0) > 180) { <details class="lp-disclosure"><summary aria-controls="category-content-@item.CategoryID">Açıklamanın tamamı</summary><p id="category-content-@item.CategoryID">@item.CategoryDescription</p></details> }
            </div>
        </article>
    }
    </div>
    @if (items.Count == 0) { <p class="lp-empty">Henüz kategori bilgisi bulunmuyor.</p> }
</div></section>
