@using Asp.NetCore6._0_LabourPest_Project.Presentation
@model List<Brands>
<section id="brands" class="lp-section"><div class="lp-container"><p>Haşere görsellerini yakından incelemek için bir görsele dokunun.</p><div class="lp-gallery lp-pest-gallery">
@foreach (var item in Model ?? new List<Brands>())
{
    <a href="@Url.Content(PublicContent.Image(item.BrandsImage))" data-gallery aria-label="Haşere görselini büyüt"><img src="@Url.Content(PublicContent.Image(item.BrandsImage))" alt="Haşere görseli" width="400" height="300" loading="lazy" data-fallback /><span aria-hidden="true">↗</span></a>
}
</div></div></section>
