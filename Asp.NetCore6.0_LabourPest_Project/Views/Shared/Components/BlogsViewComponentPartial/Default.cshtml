@model List<Blog>
@{
    var listing = ViewData["PublicListing"] as bool? == true;
    var items = (Model ?? new List<Blog>()).OrderByDescending(x => x.BlogDate).ToList();
    var pageCount = (int)Math.Ceiling(items.Count / 12d);
    var page = int.TryParse(Context.Request.Query["sayfa"], out var requested) ? Math.Clamp(requested, 1, Math.Max(1, pageCount)) : 1;
    var visible = listing ? items.Skip((page - 1) * 12).Take(12) : items.Take(3);
}
<section id="blog" class="lp-section"><div class="lp-container">
    <div class="lp-section-heading"><div><p class="lp-eyebrow">Bilgi köşesi</p><h2>Haşere kontrolüne yakından bakın.</h2></div>@if (!listing) { <a class="lp-text-link" asp-controller="Home" asp-action="Deneme" asp-route-bolum="blog">Tüm yazılar <span aria-hidden="true">↗</span></a> }</div>
    <div class="lp-grid">@foreach (var item in visible) { <partial name="~/Views/Shared/Public/_BlogCard.cshtml" model="item" /> }</div>
    @if (items.Count == 0) { <p class="lp-empty">Henüz yayımlanmış bir yazı bulunmuyor.</p> }
    @if (listing) { <partial name="~/Views/Shared/Public/_Pagination.cshtml" model="pageCount" /> }
</div></section>
