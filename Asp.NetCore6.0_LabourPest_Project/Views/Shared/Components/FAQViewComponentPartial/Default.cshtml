@{
    var items = ((ViewData["Accordion01"] as IEnumerable<FAQ>) ?? Enumerable.Empty<FAQ>())
        .Concat((ViewData["Accordion02"] as IEnumerable<FAQ>) ?? Enumerable.Empty<FAQ>()).GroupBy(x => x.FAQID).Select(x => x.First()).ToList();
    var listing = ViewData["PublicListing"] as bool? == true;
}
<section id="ss" class="lp-section lp-tinted"><div class="lp-container lp-faq-grid">
    <div><p class="lp-eyebrow">Merak ettikleriniz</p><h2>Sıkça sorulan sorular</h2><p>İlaçlama öncesi ve sonrası hakkında bilgi edinin.</p><a class="lp-text-link" asp-controller="Home" asp-action="Deneme" asp-route-bolum="sss">Tüm sorular <span aria-hidden="true">↗</span></a></div>
    <div class="lp-accordion">
    @foreach (var item in (listing ? items : items.Take(5)))
    {
        <details class="lp-disclosure" id="faq-@item.FAQID"><summary id="faq-trigger-@item.FAQID" aria-controls="faq-panel-@item.FAQID">@item.FAQTitle</summary><div id="faq-panel-@item.FAQID" aria-labelledby="faq-trigger-@item.FAQID" class="lp-prose"><p>@item.FAQDescription</p></div></details>
    }
    @if (items.Count == 0) { <p>Sorularınız için <a asp-controller="Contact" asp-action="AddContact">bize ulaşabilirsiniz</a>.</p> }
    </div>
</div></section>
