@using Asp.NetCore6._0_LabourPest_Project.Presentation
@model List<Product>
@{
    var items = Model ?? new List<Product>();
    var pageCount = (int)Math.Ceiling(items.Count / 12d);
    var page = int.TryParse(Context.Request.Query["sayfa"], out var requested) ? Math.Clamp(requested, 1, Math.Max(1, pageCount)) : 1;
}
<section id="product" class="lp-section"><div class="lp-container"><div class="lp-grid">
@foreach (var item in items.Skip((page - 1) * 12).Take(12))
{
    <article class="lp-card"><img src="@Url.Content(PublicContent.Image(item.ProductImageURL))" alt="@item.ProductName" width="600" height="400" loading="lazy" data-fallback /><div class="lp-card-body"><h2>@item.ProductName</h2><p>@PublicContent.Excerpt(item.ProductDescription)</p><a class="lp-text-link" asp-controller="Product" asp-action="ProductDetail" asp-route-id="@item.ProductID">Ürünü inceleyin <span aria-hidden="true">↗</span></a></div></article>
}
</div>@if (items.Count == 0) { <p class="lp-empty">Henüz ürün bilgisi bulunmuyor.</p> }<partial name="~/Views/Shared/Public/_Pagination.cshtml" model="pageCount" /></div></section>
