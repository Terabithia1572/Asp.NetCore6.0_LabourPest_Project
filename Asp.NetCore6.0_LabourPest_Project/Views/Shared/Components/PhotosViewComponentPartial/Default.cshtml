@using Asp.NetCore6._0_LabourPest_Project.Presentation
@model List<Image>
@{
    var listing = ViewData["PublicListing"] as bool? == true;
    var items = Model ?? new List<Image>();
    var pageCount = (int)Math.Ceiling(items.Count / 12d);
    var page = int.TryParse(Context.Request.Query["sayfa"], out var requested) ? Math.Clamp(requested, 1, Math.Max(1, pageCount)) : 1;
    var visible = listing ? items.Skip((page - 1) * 12).Take(12) : items.Take(4);
}
<section id="gallery" class="lp-section lp-gallery-section"><div class="lp-container">
    <div class="lp-section-heading"><div><p class="lp-eyebrow">Fotoğraf galerisi</p><h2>Uygulama alanlarından</h2></div>@if (!listing) { <a class="lp-text-link" asp-controller="Home" asp-action="Deneme" asp-route-bolum="galeri">Galeriyi inceleyin <span aria-hidden="true">↗</span></a> }</div>
    <div class="lp-gallery">@foreach (var item in visible) { <a href="@Url.Content(PublicContent.Image(item.ImageUpload))" data-gallery aria-label="İlaçlama uygulaması görselini büyüt"><img src="@Url.Content(PublicContent.Image(item.ImageUpload))" alt="İlaçlama uygulama alanı" width="600" height="450" loading="lazy" data-fallback /><span aria-hidden="true">↗</span></a> }</div>
    @if (items.Count == 0) { <p class="lp-empty">Henüz galeri görseli bulunmuyor.</p> }
    @if (listing) { <partial name="~/Views/Shared/Public/_Pagination.cshtml" model="pageCount" /> }
</div></section>
