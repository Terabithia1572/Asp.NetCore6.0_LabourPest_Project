@model Asp.NetCore6._0_LabourPest_Project.Models.PublicReviewInput
@inject Microsoft.Extensions.Options.IOptions<Asp.NetCore6._0_LabourPest_Project.Presentation.Reviews.RecaptchaOptions> CaptchaOptions
<section id="comment" class="lp-section"><div class="lp-container lp-review-form-grid">
    <div class="lp-review-intro"><p class="lp-eyebrow">Görüşleriniz bizim için değerli</p><h2>Yorumunuzu paylaşın</h2><p>Deneyiminizi ve önerilerinizi bizimle paylaşabilirsiniz.</p><p class="lp-help">* işaretli alanların doldurulması gerekir. Fotoğraf eklemek isteğe bağlıdır.</p></div>
    <div>
    @if (TempData["ReviewSuccess"] is string success) { <p role="status" tabindex="-1" data-review-feedback class="lp-form-feedback lp-form-success">@success</p> }
    <form class="lp-form lp-panel" method="post" asp-controller="MainComment" asp-action="AddComment" data-review-form data-upload-url="@Url.Action("UploadImage", "MainComment")">
        @if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" role="alert" tabindex="-1" data-review-feedback class="lp-form-feedback"></div> }
        <div class="lp-form-grid">
            <div><label for="CommentUserName">Adınız soyadınız *</label><input asp-for="CommentUserName" type="text" required aria-required="true" autocomplete="name" maxlength="100" aria-describedby="review-name-error" /><span asp-validation-for="CommentUserName" id="review-name-error"></span></div>
            <div><label for="CommentTitle">Konu *</label><input asp-for="CommentTitle" type="text" required aria-required="true" maxlength="200" aria-describedby="review-title-error" /><span asp-validation-for="CommentTitle" id="review-title-error"></span></div>
        </div>
        <div><label for="CommentContent">Mesajınız *</label><textarea asp-for="CommentContent" rows="4" required aria-required="true" maxlength="5000" aria-describedby="review-content-error"></textarea><span asp-validation-for="CommentContent" id="review-content-error"></span></div>
        <div><label for="review-photo">Fotoğrafınız (isteğe bağlı)</label><input type="file" name="file" id="review-photo" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" aria-describedby="review-upload-status" /><input asp-for="ImageUrl" type="hidden" id="review-image-url" /><span asp-validation-for="ImageUrl"></span><p id="review-upload-status" class="lp-help" role="status">@(string.IsNullOrWhiteSpace(Model?.ImageUrl) ? "" : "Yüklenmiş fotoğraf bağlantınız korundu.")</p>
        @if (ViewData["ReviewFailure"] as bool? == true) { <p class="lp-help">Dosya seçimi geri yüklenemez. Fotoğraf yüklemesi tamamlanmadıysa yeniden seçin; fotoğrafsız da gönderebilirsiniz.</p> }
        </div>
        <div class="lp-review-submit">
            <div class="lp-captcha-area"><div data-review-captcha data-sitekey="@CaptchaOptions.Value.SiteKey"></div><p class="lp-help" id="review-captcha-status" role="status" tabindex="-1">Robot doğrulaması form görünür olduğunda yüklenecek.</p><button class="lp-text-link" type="button" data-captcha-retry hidden>Doğrulamayı yeniden yükle</button></div>
            <button class="lp-button lp-button-light" type="submit" disabled aria-describedby="review-captcha-status">Yorumu gönder <span aria-hidden="true">↗</span></button>
        </div>
        <noscript><p class="field-validation-error">Yorum göndermek ve robot doğrulamasını tamamlamak için tarayıcınızda JavaScript'i etkinleştirin.</p></noscript>
    </form>
    </div>
</div></section>
