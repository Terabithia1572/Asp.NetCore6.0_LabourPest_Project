@using Asp.NetCore6._0_LabourPest_Project.Presentation
@model Product
@{ ViewData["Title"] = Model?.ProductName ?? "Ürün bilgisi"; Layout = "~/Views/Shared/_PublicLayout.cshtml"; }
<header class="lp-page-heading"><div class="lp-container"><nav class="lp-breadcrumb" aria-label="İçerik yolu"><a asp-controller="Home" asp-action="Deneme">Ana Sayfa</a><span aria-hidden="true">/</span><a asp-controller="Home" asp-action="Deneme" asp-route-bolum="urunler">Ürünler</a></nav><h1>@ViewData["Title"]</h1></div></header>
<section class="lp-section"><div class="lp-container lp-reading">
@if (Model != null)
{
    <article class="lp-prose"><img class="lp-detail-image" src="@Url.Content(PublicContent.Image(Model.ProductImageURL))" alt="@Model.ProductName" width="800" height="500" data-fallback /><p>@Model.ProductDescription</p></article>
}
else { <p>Ürün bilgisi bulunamadı.</p> }
</div></section><partial name="~/Views/Shared/Public/_ContactCta.cshtml" />
